# Pinned build inputs. Every download is verified against these SHA-256 digests,
# so changing a version here means changing its digest in the same commit.

# static-php-cli, from https://github.com/crazywhalecc/static-php-cli/releases
SPC_VERSION=2.8.5
SPC_SHA256_LINUX_X86_64=523ba4279c54c7a377156c0dd3a36adf92ee64b01e9a7f5e9e2ec084b8e458e5
SPC_SHA256_LINUX_AARCH64=675a3840dcdc4ed041fe20eaa54310ce019a9984c1c03951df9ec66df5795213
SPC_SHA256_MACOS_AARCH64=acf2f25d56d0cbf8e65aa82e5054fef555f7be7c5c38046c6e0819f266d83225

# Composer, from https://getcomposer.org/download/
COMPOSER_VERSION=2.10.3
COMPOSER_SHA256=7a2d379d5b8ffdaa028580ef26494c36d2feef4b178d3dd1473a4dbc5e17c8d6

# Linux builds link against this glibc, so they run on any distro with glibc 2.17 or newer
GLIBC_VERSION=2.17
